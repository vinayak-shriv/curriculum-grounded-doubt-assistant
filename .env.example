# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=

# Embedding backend: "minilm" for sentence-transformers, "hash" to run offline.
EMBEDDER=minilm

# SQLite by default; point at MySQL to use that instead, e.g.
# DATABASE_URL=mysql+pymysql://user:password@localhost/doubt_assistant
DATABASE_URL=sqlite:///./app.db

# Abstention gate. Calibrate against your own corpus -- see README.
ABSTAIN_MIN_SIMILARITY=0.32
ABSTAIN_MIN_BM25=5.0
